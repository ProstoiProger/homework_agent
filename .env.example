TELEGRAM_BOT_TOKEN=1234567890:replace_me
TEACHER_TELEGRAM_ID=123456789

GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.5-flash-lite

# If OPENROUTER_API_KEY is set, it takes priority over Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

DATABASE_URL=sqlite:///homework.db
TIMEZONE=Asia/Qyzylorda
RESOURCE_STORAGE_DIR=resources
RESOURCE_MAX_FILE_MB=20
HOMEWORK_DELIVERY_MODE=pdf
HOMEWORK_PDF_DIR=generated_homeworks

# OAuth Desktop client: recommended for a personal Google Calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_TOKEN_FILE=credentials/google-calendar-token.json

# Alternative for a server account. Leave empty when OAuth is used.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_SUBJECT=

CALENDAR_SYNC_INTERVAL_MINUTES=30
LESSON_DURATION_MINUTES=45
LESSON_END_REMINDER_MINUTES=2
EVENING_SUMMARY_AT=21:00
